{
  "name": "ai-dnd",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @ai-dnd/web",
    "dev:api": "npm run dev -w @ai-dnd/api",
    "build": "npm run build -w @ai-dnd/web",
    "build:api": "npm run build -w @ai-dnd/domain && npm run build -w @ai-dnd/contracts && npm run build -w @ai-dnd/dm && npm run build -w @ai-dnd/db && npm run build -w @ai-dnd/api",
    "db:local:up": "docker compose -f infra/docker-compose.local.yml up -d postgres",
    "db:local:down": "docker compose -f infra/docker-compose.local.yml down",
    "db:migrate": "node scripts/run-db-migrations.mjs",
    "db:local:reset": "node scripts/reset-local-db.mjs && npm run db:migrate",
    "db:local:seed": "node scripts/seed-local-db.mjs",
    "dashboard:users": "node scripts/generate-user-message-dashboard.mjs",
    "cutover:production:verify": "node scripts/verify-production-cutover.mjs",
    "cutover:production:health": "scripts/check-production-health.sh",
    "production:monitor": "scripts/check-production-monitoring.sh",
    "media:spaces:setup": "node scripts/setup-media-space.mjs",
    "pr:auto-merge": "bash scripts/pr-auto-merge.sh",
    "pr:promote-production": "bash scripts/promote-production.sh",
    "droplet:one-time-access": "node scripts/run-droplet-one-time-access.mjs",
    "droplet:preflight": "node scripts/droplet-access-preflight.mjs",
    "lint": "npm run lint -w @ai-dnd/web",
    "coverage": "npm run coverage --workspaces --if-present",
    "coverage:check": "node scripts/check-coverage-thresholds.mjs",
    "test:e2e:db:reset": "node scripts/reset-playwright-db.mjs",
    "test:e2e": "playwright test",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "dependencies": {
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/pg": "^8.20.0",
    "c8": "^11.0.0"
  }
}
