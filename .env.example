DEEPSEEK_API_KEY=
# Optional. Defaults to deepseek-v4-flash.
DEEPSEEK_MODEL=
# Optional. Defaults to https://api.deepseek.com.
DEEPSEEK_BASE_URL=
QWEN_API_KEY=
# Optional. Defaults to qwen3.7-flash.
QWEN_MODEL=
# Optional. Defaults to https://dashscope-intl.aliyuncs.com/compatible-mode/v1.
QWEN_BASE_URL=
QWEN_IMAGE_API_KEY=
# Optional. Defaults to qwen-image-2.0-pro.
QWEN_IMAGE_MODEL=
# Optional. Defaults to DashScope international image generation endpoint.
QWEN_IMAGE_ENDPOINT=
OPENAI_API_KEY=
# Optional. Defaults to gpt-image-2.
OPENAI_IMAGE_MODEL=
# Optional. Defaults to https://api.openai.com/v1/images/generations.
OPENAI_IMAGE_ENDPOINT=
DATABASE_URL=
# Set to true only for a local Postgres without SSL.
DATABASE_SSL_DISABLED=false
# Optional. Used by the web app's server routes to reach the Fastify API.
FASTIFY_API_INTERNAL_ORIGIN=http://localhost:4000
# Optional. Mixpanel browser SDK project token for client-side funnel events.
NEXT_PUBLIC_MIXPANEL_TOKEN=
# Optional. Mixpanel server-side project token for durable API lifecycle events.
MIXPANEL_PROJECT_TOKEN=
# AI Taverns Mixpanel project id.
MIXPANEL_PROJECT_ID=4049394
MIXPANEL_ENABLED=false
MIXPANEL_DEBUG=false
# Optional. Used by the API to build magic links.
AUTH_PUBLIC_APP_ORIGIN=http://localhost:3000
# Optional in local development. Required in production for magic-link email.
AUTH_EMAIL_FROM="AI Taverns <noreply@example.com>"
RESEND_API_KEY=
