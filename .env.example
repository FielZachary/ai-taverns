DEEPSEEK_API_KEY=
# Optional. Defaults to deepseek-chat.
DEEPSEEK_MODEL=
# Optional. Defaults to https://api.deepseek.com.
DEEPSEEK_BASE_URL=
DATABASE_URL=
# Set to true only for a local Postgres without SSL.
DATABASE_SSL_DISABLED=false
# Optional. Used by the web app's server routes to reach the Fastify API.
FASTIFY_API_INTERNAL_ORIGIN=http://localhost:4000
# Optional. Used by the API to build magic links.
AUTH_PUBLIC_APP_ORIGIN=http://localhost:3000
# Optional in local development. Required in production for magic-link email.
AUTH_EMAIL_FROM="AI Taverns <noreply@example.com>"
RESEND_API_KEY=
