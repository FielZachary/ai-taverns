DATABASE_SSL_DISABLED=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Alternative accepted by the app if your dashboard shows an anon public key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
