HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
WEB_ORIGINS=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_taverns
DATABASE_SSL_DISABLED=true
DATABASE_POOL_MAX=10
AUTH_COOKIE_NAME=ai_taverns_session
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_DAYS=30
AUTH_LOGIN_TOKEN_TTL_MINUTES=15
AUTH_EXPOSE_LOCAL_LOGIN_TOKENS=true
AUTH_PUBLIC_APP_ORIGIN=http://localhost:3000
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
QWEN_API_KEY=
QWEN_MODEL=qwen3.7-flash
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_IMAGE_API_KEY=
QWEN_IMAGE_MODEL=qwen-image-2.0-pro
QWEN_IMAGE_ENDPOINT=https://dashscope-intl.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation

MEDIA_STORAGE_DRIVER=local
MEDIA_LOCAL_DIR=.local-media
MEDIA_PUBLIC_BASE_URL=/media
SPACES_ENDPOINT=
SPACES_REGION=
SPACES_BUCKET=
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=
# DigitalOcean-style aliases are also accepted:
DIGITALOCEAN_SPACES_ACCESS_KEY=
DIGITALOCEAN_SPACES_SECRET_KEY=
