HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
WEB_ORIGINS=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_taverns
DATABASE_SSL_DISABLED=true
DATABASE_POOL_MAX=10
AUTH_COOKIE_NAME=ai_taverns_session
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_DAYS=30
AUTH_LOGIN_TOKEN_TTL_MINUTES=15
AUTH_EXPOSE_LOCAL_LOGIN_TOKENS=true
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
QWEN_API_KEY=
QWEN_MODEL=qwen3.7-flash
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

MEDIA_STORAGE_DRIVER=local
MEDIA_LOCAL_DIR=.local-media
MEDIA_PUBLIC_BASE_URL=/media
SPACES_ENDPOINT=
SPACES_REGION=
SPACES_BUCKET=
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=
