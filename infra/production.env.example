# Copy to /opt/ai-taverns/infra/production.env on the droplet and fill every value.
PRODUCTION_DOMAIN=example.com
ACME_EMAIL=ops@example.com

POSTGRES_DB=ai_taverns
POSTGRES_USER=ai_taverns
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://ai_taverns:replace-with-a-long-random-password@postgres:5432/ai_taverns
DATABASE_SSL_DISABLED=true
DATABASE_POOL_MAX=10

NODE_ENV=production
LOG_LEVEL=info
WEB_ORIGINS=https://example.com
FASTIFY_API_INTERNAL_ORIGIN=http://api:4000
NEXT_PUBLIC_FASTIFY_API_ORIGIN=https://example.com

AUTH_COOKIE_NAME=ai_taverns_session
AUTH_COOKIE_SECURE=true
AUTH_SESSION_TTL_DAYS=30
AUTH_LOGIN_TOKEN_TTL_MINUTES=15
AUTH_EXPOSE_LOCAL_LOGIN_TOKENS=false
AUTH_PUBLIC_APP_ORIGIN=https://example.com
AUTH_EMAIL_FROM="AI Taverns <noreply@example.com>"
RESEND_API_KEY=replace-with-resend-api-key

DEEPSEEK_API_KEY=replace-with-provider-key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
QWEN_API_KEY=replace-with-qwen-provider-key
QWEN_MODEL=qwen3.7-flash
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30
CUTOVER_STRICT_OWNERS=false

# Optional production monitor thresholds and webhook. The monitor exits non-zero
# and posts to ALERT_WEBHOOK_URL when a check fails.
PRODUCTION_ORIGIN=https://example.com
DISK_USAGE_WARN_PERCENT=85
BACKUP_MAX_AGE_HOURS=26
POSTGRES_CONNECTION_WARN_PERCENT=80
CONTAINER_CPU_WARN_PERCENT=90
CONTAINER_MEMORY_WARN_PERCENT=90
ALERT_WEBHOOK_URL=
