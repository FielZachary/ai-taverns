# Copy to /opt/ai-taverns/staging.env on the droplet and fill every value.
STAGING_DOMAIN=staging.example.com
ACME_EMAIL=ops@example.com

POSTGRES_DB=ai_taverns
POSTGRES_USER=ai_taverns
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://ai_taverns:replace-with-a-long-random-password@postgres:5432/ai_taverns
DATABASE_SSL_DISABLED=true
DATABASE_POOL_MAX=10

NODE_ENV=production
LOG_LEVEL=info
WEB_ORIGINS=https://staging.example.com
FASTIFY_API_INTERNAL_ORIGIN=http://api:4000
NEXT_PUBLIC_FASTIFY_API_ORIGIN=https://staging.example.com

AUTH_COOKIE_NAME=ai_taverns_session
AUTH_COOKIE_SECURE=true
AUTH_SESSION_TTL_DAYS=30
AUTH_LOGIN_TOKEN_TTL_MINUTES=15
AUTH_EXPOSE_LOCAL_LOGIN_TOKENS=false
AUTH_PUBLIC_APP_ORIGIN=https://staging.example.com
AUTH_EMAIL_FROM="AI Taverns <noreply@example.com>"
RESEND_API_KEY=replace-with-resend-api-key

DEEPSEEK_API_KEY=replace-with-provider-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
