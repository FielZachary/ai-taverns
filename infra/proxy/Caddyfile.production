{
	email {$ACME_EMAIL}
}

www.{$PRODUCTION_DOMAIN} {
	redir https://{$PRODUCTION_DOMAIN}{uri} permanent
}

{$PRODUCTION_DOMAIN} {
	encode zstd gzip

	handle /health {
		reverse_proxy api:4000
	}

	handle /api/* {
		reverse_proxy api:4000
	}

	handle /media/* {
		reverse_proxy api:4000
	}

	handle {
		reverse_proxy web:3000
	}
}
