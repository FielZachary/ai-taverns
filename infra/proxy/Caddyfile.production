{
	email {$ACME_EMAIL}
}

{$PRODUCTION_DOMAIN}, www.{$PRODUCTION_DOMAIN} {
	encode zstd gzip

	handle /health {
		reverse_proxy api:4000
	}

	handle /api/* {
		reverse_proxy api:4000
	}

	handle {
		reverse_proxy web:3000
	}
}

{$STAGING_DOMAIN:staging.aitaverns.com} {
	encode zstd gzip

	handle /health {
		reverse_proxy staging-api:4000
	}

	handle /api/* {
		reverse_proxy staging-api:4000
	}

	handle {
		reverse_proxy staging-web:3000
	}
}
