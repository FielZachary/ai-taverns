{
  "name": "@ai-dnd/contracts",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./auth": {
      "types": "./src/auth.ts",
      "import": "./dist/auth.js"
    },
    "./errors": {
      "types": "./src/errors.ts",
      "import": "./dist/errors.js"
    },
    "./health": {
      "types": "./src/health.ts",
      "import": "./dist/health.js"
    }
  },
  "main": "./dist/index.js",
