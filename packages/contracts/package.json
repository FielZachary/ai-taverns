  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-dnd/domain": "0.0.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@ai-dnd/tsconfig": "0.0.1",
